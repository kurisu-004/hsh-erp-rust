  "query": "\n            SELECT id, serial_no, name, drawing_no, customer_id, assembly_id, status,\n                   version, created_at, created_by, updated_at, updated_by, deleted_at,\n                   delivery_note_id\n            FROM t_part\n            WHERE assembly_id = $1\n              AND ($2::bool OR deleted_at IS NULL)\n            ORDER BY id ASC\n            ",
