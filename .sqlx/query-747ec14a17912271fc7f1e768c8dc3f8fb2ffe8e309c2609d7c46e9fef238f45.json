  "query": "\n            SELECT id        AS \"id!\",\n                   part_id   AS \"part_id!\",\n                   version   AS \"version!\"\n            FROM t_part_batch\n            WHERE status     = 'DELIVERED'\n              AND deleted_at IS NULL\n              AND placed_at  IS NOT NULL\n              AND placed_at  < $1\n            ORDER BY placed_at ASC, id ASC\n            ",
