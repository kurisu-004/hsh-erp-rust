  "query": "\n            SELECT id, name, parent_id, version,\n                   created_at, created_by, updated_at, updated_by, deleted_at,\n                   serial_prefix\n            FROM t_customer\n            WHERE id = ANY($1)\n              AND ($2::bool OR deleted_at IS NULL)\n            ORDER BY id ASC\n            ",
