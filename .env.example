# --- HTTP ---
LISTEN_ADDR=0.0.0.0:3000

# --- PostgreSQL (sqlx 使用 postgres:// scheme) ---
DATABASE_URL=postgres://hsh:6065161@localhost:5430/hsh

# --- Docker Compose ---
POSTGRES_USER=hsh
POSTGRES_PASSWORD=6065161
TZ=Asia/Shanghai

# --- Docker Compose (Test DB) ---
POSTGRES_TEST_HOST=localhost
POSTGRES_TEST_PORT=5429
POSTGRES_TEST_USER=hsh_test
POSTGRES_TEST_PASSWORD=6065161test
POSTGRES_TEST_DB=postgres_rust_test

# --- JWT 双 token ---
JWT_SECRET=replace-me-with-strong-secret-at-least-32-chars
JWT_ISSUER=hsh-erp
JWT_ACCESS_TOKEN_EXPIRE_HOURS=24
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- 雪花 ID（41+5+5+12 位）---
SNOWFLAKE_INSTANCE=0
SNOWFLAKE_SEQ=0
SNOWFLAKE_EPOCH=1735689600000

# --- 腾讯云 COS（占位；业务实现阶段注入真实凭据）---
# 是否启用真实 COS 上传（默认 true）
# true：使用 TencentCos（真实 PUT/GET/DELETE 到腾讯云，需配齐 COS_SECRET_* 等凭据）
# false：使用 NoopCos（静默成功，put_object 不真传），用于本地 cargo run 调试
COS_ENABLED=true
COS_APP_ID=
COS_ENDPOINT=
COS_SECRET_ID=replace-me
COS_SECRET_KEY=replace-me
COS_REGION=replace-me
COS_BUCKET=replace-me

COS_SCHEME=https
COS_UPLOAD_PREFIX=drawings/
COS_PRESIGN_EXPIRE=900
COS_MAX_FILE_SIZE=104857600
COS_ALLOWED_TYPES=pdf,step,stp,dwg,dxf,nc,tap,cnc,mpf,ngc

# 2026-09-16 M2-A 新增：STS 临时凭证有效期（秒），默认 900（与 COS_PRESIGN_EXPIRE 对齐）。
# 2026-09-18 注：原 `TencentSts` 已删除（rust 不再直连 STS），此字段保留以兼容 .env，
# 实际生效的 STS duration 由 upload_session 域 `UPLOAD_SESSION_STS_DURATION_SECONDS` 控制。
COS_STS_DURATION_SECONDS=900
# 2026-09-16 M2-A 新增：STS 凭证写入 prefix 模板前缀（含尾斜杠）。
# 2026-09-18 更新：除 STS 外，confirm handler 的 `tmp_key` 前缀校验也使用此字段；
# upload_session 域的 `tmp/sess/<uuid>/` 派生同样基于此前缀。缺省 `tmp/`。
COS_TMP_PREFIX=tmp/

# ==== 2026-09-18 M3-B 新增：upload_session 域（Redis 共享 STS 凭证机制）====
# python 后端 base URL（rust 通过 HTTP 转发到 python 端 `/api/v1/files/sts-prefix-credentials`
# 签发 STS）。留空 → NoopPythonSts（本地 cargo run 不依赖 python 后端）。
PYTHON_BACKEND_BASE_URL=http://backend:8000
# Redis 会话条目 TTL（秒）；每次写都 SET EX 续期。缺省 24h。
UPLOAD_SESSION_TTL_SECONDS=86400
# 请求 python 签发时的 expire_seconds（python 端可能按自身配置上下限收敛）。
# 缺省 7200s（2h，比 STS 默认 900s 长以减少 renew 频率）。
UPLOAD_SESSION_STS_DURATION_SECONDS=7200
# get_or_create hit 路径下，凭证剩余有效期 < 此阈值 → 自动 renew。缺省 600s（10min）。
UPLOAD_SESSION_RENEW_THRESHOLD_SECONDS=600

# --- 请求体上限（默认 300MB，与 nginx client_max_body_size 对齐）---
MAX_REQUEST_BODY_SIZE=314572800

# --- HTTP nest 请求超时（2026-09-20 新增，仅作用于 /api/v2/*；不影响 WS 长连接）---
# REQUEST_TIMEOUT_SECONDS=30

# --- 后台自动完成任务 ---
AUTO_COMPLETE_THRESHOLD_DAYS=7
AUTO_COMPLETE_INTERVAL_HOURS=24

# --- _e2e hook 开关（2026-09-14 新增）---
# 是否启用 /api/v2/_e2e/* 路由（probe/reset/seed/*/revoke-session）。
# dev/test 默认 true；prod 必须显式 false。详见 src/modules/_e2e/mod.rs 文档。
E2E_HOOKS_ENABLED=true

# --- 送货单 Excel 模板目录（P4 print.rs；相对仓库根；prefix → 文件名约定见
#     delivery_note_print.py：F→delivery_note_fala.xlsx，L→delivery_note_luda.xlsx）---
DELIVERY_NOTE_TEMPLATE_DIR=template

# --- 日志级别 (RUST_LOG) ---
RUST_LOG=info,sqlx=warn,tower_http=info

# --- Redis（用户会话存储，服务端 session 真相源）---
# 完整 URL 优先；否则按 REDIS_HOST/PORT/DB/PASSWORD 拆分拼接（默认 localhost:6379）
REDIS_URL=redis://localhost:6379
# session 条目 TTL（秒）；extractor 每次成功访问会 EXPIRE 续期
REDIS_SESSION_TTL_SECONDS=43200
# deadpool-redis 连接池上限
REDIS_POOL_MAX_SIZE=10
# 是否启用服务端 Redis session 校验（默认 true）。
# 设为 false 时：extractor 不查 Redis、main.rs 不建连接池、login/refresh/logout 的 session 写入走 no-op。
# 用于 Rust 借 Python JWT 签发的过渡期；切回 true 后必须重新登录。
REDIS_SESSION_CHECK_ENABLED=true