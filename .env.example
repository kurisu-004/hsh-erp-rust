# --- HTTP ---
LISTEN_ADDR=0.0.0.0:3000

# --- PostgreSQL (sqlx 使用 postgres:// scheme) ---
DATABASE_URL=postgres://erp:erp@localhost:5433/hsh_erp

# --- JWT 双 token ---
JWT_SECRET=replace-me-with-strong-secret-at-least-32-chars
JWT_ISSUER=hsh-erp
JWT_ACCESS_TOKEN_EXPIRE_HOURS=12
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- 雪花 ID（41+5+5+12 位）---
SNOWFLAKE_INSTANCE=1
SNOWFLAKE_SEQ=1
# 自定义纪元：2020-01-01 UTC = 1577836800000
SNOWFLAKE_EPOCH=1577836800000

# --- 腾讯云 COS（占位；业务实现阶段注入真实凭据）---
COS_REGION=ap-shanghai
COS_BUCKET=replace-me
COS_SECRET_ID=replace-me
COS_SECRET_KEY=replace-me
COS_SCHEME=https
COS_UPLOAD_PREFIX=uploads
COS_PRESIGN_EXPIRE=3600
COS_MAX_FILE_SIZE=314572800

# --- 请求体上限（默认 300MB，与 nginx client_max_body_size 对齐）---
MAX_REQUEST_BODY_SIZE=314572800

# --- 后台自动完成任务 ---
AUTO_COMPLETE_THRESHOLD_DAYS=7
AUTO_COMPLETE_INTERVAL_HOURS=24

# --- 日志级别 (RUST_LOG) ---
RUST_LOG=info,sqlx=warn,tower_http=info